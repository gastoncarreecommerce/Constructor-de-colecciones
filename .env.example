# Copiá este archivo a .env para correr el job de datos en local.
# .env NUNCA se commitea (ver .gitignore). En CI estas variables salen de
# GitHub Secrets, y en Vercel (si /api las necesita) de las Environment
# Variables del proyecto — son dos lugares separados, no se comparten solos.

VTEX_ACCOUNT_NAME=
VTEX_APP_KEY=
VTEX_APP_TOKEN=
VTEX_SALES_CHANNEL=
